---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class={`border-t border-base-300 py-8 text-center text-xs opacity-75 ${className}`}>
  <div class="max-w-5xl mx-auto px-4 space-y-2">
    <p class="font-serif font-bold text-sm">
      Les Cahiers du Praticien
    </p>
    <p class="font-sans">
      Revue algérienne de médecine pratique • Archives médicales digitalisées
    </p>
  </div>
</footer>
