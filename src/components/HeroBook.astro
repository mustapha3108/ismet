---
import { Image } from 'astro:assets';

interface Book {
  id: string;
  edition: string;
  title: string;
  description: string;
  issn: string;
  coverImage: any;
  pdfUrl: string;
}

interface Props {
  book: Book;
  themeStyle?: 'swiss' | 'daylight' | 'minimal';
}

const { book, themeStyle = 'swiss' } = Astro.props;
const readUrl = `/read?id=${book.id}`;
---

<section class="py-12 sm:py-16 border-b border-base-300 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">
      
      <!-- Colonne Couverture Réaliste 3D (5 cols) -->
      <div class="md:col-span-5 flex justify-center py-4">
        <a 
          href={readUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="magazine-3d-wrapper group block w-full max-w-[280px]"
          title="Ouvrir la revue dans le lecteur interactif"
        >
          <div class={`journal-cover-a4 rounded-sm border border-neutral-800 ${
            themeStyle === 'daylight' ? 'magazine-daylight-cover' : 'magazine-3d-cover'
          }`}>
            <Image 
              src={book.coverImage} 
              alt={`${book.edition} - ${book.title}`} 
              class="w-full h-full object-cover"
              width={600}
              height={848}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              format="webp"
            />
            <!-- Effet de survol sur la couverture -->
            <div class="absolute inset-0 bg-neutral-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="bg-primary text-primary-content font-bold px-4 py-2 text-xs uppercase tracking-wider shadow-lg transform translate-y-2 group-hover:translate-y-0 transition-transform">
                Feuilleter le numéro →
              </span>
            </div>
          </div>
        </a>
      </div>

      <!-- Colonne Contenu & Actions (7 cols) -->
      <div class="md:col-span-7 space-y-5">
        <!-- Métadonnées du numéro -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
          <span class="font-bold opacity-80">{book.edition}</span>
          <span class="opacity-40">•</span>
          <span class="opacity-75">{book.issn}</span>
        </div>

        <!-- Titre Editorial -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold leading-[1.2] tracking-tight">
          {book.title}
        </h2>

        <!-- Description -->
        <p class="text-base sm:text-lg opacity-85 leading-relaxed">
          {book.description}
        </p>

        <!-- Boutons d'Action Premium -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a 
            href={readUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2.5 bg-primary text-primary-content hover:opacity-95 font-black text-sm px-7 py-3.5 rounded-sm transition-all shadow-[4px_4px_0px_#0A0A0A] hover:shadow-[6px_6px_0px_#0A0A0A] hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>Feuilleter la revue</span>
          </a>

          <a 
            href={book.pdfUrl} 
            download 
            class="inline-flex items-center justify-center gap-2 border border-base-300 hover:border-current bg-base-100 hover:bg-base-200 px-5 py-3.5 rounded-sm text-sm font-semibold transition-colors"
          >
            <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Télécharger (PDF)</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
