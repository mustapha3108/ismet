---
interface Props {
  current: 'v1' | 'v2' | 'v3';
}

const { current } = Astro.props;

const versions = [
  { id: 'v1', name: 'Version 1 : Rétro Noir & Jaune', url: '/' },
  { id: 'v2', name: 'Version 2 : Solaire & Sarcelle', url: '/version-2' },
  { id: 'v3', name: 'Version 3 : Épuré Minimal', url: '/version-3' },
];
---

<nav aria-label="Aperçu des thèmes" class="bg-neutral-900 text-neutral-300 text-xs border-b border-neutral-800 py-2 px-4 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-primary"></span>
      <span class="font-medium text-neutral-400">Présentation client :</span>
    </div>
    <div class="flex items-center gap-1 sm:gap-2">
      {versions.map((ver) => (
        <a
          href={ver.url}
          class={`px-2.5 py-1 rounded transition-colors text-xs font-semibold ${
            current === ver.id
              ? 'bg-primary text-primary-content shadow-sm'
              : 'hover:bg-neutral-800 text-neutral-300'
          }`}
        >
          {ver.name}
        </a>
      ))}
    </div>
  </div>
</nav>
