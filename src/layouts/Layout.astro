---
import '../styles/global.css';

interface Props {
	title?: string;
	theme?: string;
}

const { title = "Les Cahiers du Praticien", theme = "cahiers-swiss" } = Astro.props;
---
<!doctype html>
<html lang="fr" data-theme={theme}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content="Revue algérienne de médecine pratique" />
		<link rel="canonical" href="https://lescahiersdupraticien.com/" />

		<!-- Favicons & Touch Icons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:site_name" content="Les Cahiers du Praticien" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Revue algérienne de médecine pratique" />
		<meta property="og:image" content="https://lescahiersdupraticien.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:type" content="website" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="Revue algérienne de médecine pratique" />
		<meta name="twitter:image" content="https://lescahiersdupraticien.com/og-image.png" />

		<!-- Google & Schema.org JSON-LD -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Periodical",
			"name": "Les Cahiers du Praticien",
			"alternateName": "LCP",
			"description": "Revue algérienne de médecine pratique",
			"issn": "7481-2507",
			"image": "https://lescahiersdupraticien.com/og-image.png"
		}
		</script>

		<!-- Performance: DNS Prefetch & Preconnect for Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..600&family=Titan+One&display=swap" />
	</head>
	<body class="min-h-screen bg-base-100 text-base-content antialiased">
		<slot />
		<script is:inline>
			(() => {
				const killNetlify = () => {
					document.querySelectorAll('iframe[src*="netlify"], iframe[title*="Netlify"], iframe[title*="netlify"], iframe[id*="netlify"], #netlify-badge, .netlify-badge, netlify-drawer, [data-netlify-badge], [data-netlify-deploy-id]').forEach(el => el.remove());
				};
				killNetlify();
				if (typeof MutationObserver !== 'undefined') {
					new MutationObserver(killNetlify).observe(document.documentElement, { childList: true, subtree: true });
				}
			})();
		</script>
	</body>
</html>
